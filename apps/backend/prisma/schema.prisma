generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  email    String  @unique()
  password String?

  displayName String  @map("display_name")
  picture     String?

  role UserRole @default(REGULAR)

  isVerified Boolean @default(false) @map("is_verified")

  method AuthMethod

  mutedAt    DateTime? @map("muted_at")
  mutedUntil DateTime? @map("muted_until")
  muteReason String?   @map("mute_reason")

  mutedBy   User?   @relation("UserMute", fields: [mutedById], references: [id], onDelete: SetNull)
  mutedById String? @map("muted_by_id")
  mutedUsers User[] @relation("UserMute")

  accounts Account[]
  builds   Build[]
  comments Comment[]
  votes    Vote[]
  moderatedComments Comment[] @relation("CommentModeration")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([mutedById])
  @@map("users")
}

model Account {
  id String @id @default(uuid())

  type              String
  provider          String
  providerAccountId String @map("provider_account_id")

  refreshToken String? @map("refresh_token")
  accessToken  String? @map("access_token")
  expiredAt    Int     @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Token {
  id String @id @default(uuid())

  email     String
  token     String    @unique
  type      TokenType
  expiresIn DateTime  @map("expires_in")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, type])
  @@map("tokens")
}

model Build {
  id String @id @default(uuid())

  title  String
  heroId String @map("hero_id")
  items  String

  author User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  comments Comment[]
  votes    Vote[]

  positiveVotes    Int @default(0) @map("positive_votes")
  situationalVotes Int @default(0) @map("situational_votes")
  negativeVotes    Int @default(0) @map("negative_votes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([createdAt])
  @@index([positiveVotes])
  @@map("builds")
}

model Vote {
  id String @id @default(uuid())

  verdict VoteVerdict

  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String @map("build_id")

  voterKey String  @map("voter_key")
  voter    User?   @relation(fields: [voterId], references: [id], onDelete: SetNull)
  voterId  String? @map("voter_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([buildId, voterKey])
  @@index([voterId])
  @@map("votes")
}

model Comment {
  id String @id @default(uuid())

  text String

  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String @map("build_id")

  author User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  deletedAt   DateTime? @map("deleted_at")
  deletedBy   User?     @relation("CommentModeration", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById String?   @map("deleted_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([buildId, createdAt])
  @@index([userId])
  @@index([deletedById])
  @@map("comments")
}

enum UserRole {
  REGULAR
  ADMIN
}

enum VoteVerdict {
  POSITIVE
  SITUATIONAL
  NEGATIVE
}

enum AuthMethod {
  CREDENTIALS
  GOOGLE
}

enum TokenType {
  VERIFICATION
  PASSWORD_RESET
}
