# Скопируйте в .env и заполните. Значения записаны целиком, без ${...}:
# process.loadEnvFile() в apps/backend/src/load-env.ts подстановку не делает,
# и ссылки вида ${POSTGRES_USER} попадали в POSTGRES_URI как есть.

NODE_ENV='development'

APPLICATION_PORT=4000
APPLICATION_URL='http://localhost:4000'
ALLOWED_ORIGIN='http://localhost:3000'

# Папка для загруженных файлов (аватарки лежат в её подпапке avatars и
# раздаются по /uploads/avatars). Пусто — <корень проекта>/uploads.
UPLOADS_DIR=''

# Swagger — полная карта API. В проде оставлять 'false'.
SWAGGER_ENABLED='true'

# За реверс-прокси: число доверенных хопов ('1' для одного прокси), 'true',
# или список адресов. Пусто — доверять только прямому соединению. Без этого
# req.ip равен адресу прокси: throttler считает всех клиентов одним ведром.
TRUST_PROXY=''

POSTGRES_USER='root'
POSTGRES_PASSWORD='example_password'
POSTGRES_HOST='localhost'
POSTGRES_PORT=5433
POSTGRES_DB='build-verdict'
POSTGRES_URI='postgresql://root:example_password@localhost:5433/build-verdict'

REDIS_USER='default'
REDIS_PASSWORD='example_password'
REDIS_HOST='localhost'
REDIS_PORT=6379
REDIS_URI='redis://default:example_password@localhost:6379'

# Минимум 32 случайных байта: `openssl rand -base64 32`.
JWT_ACCESS_SECRET='change_me_access_secret'
JWT_ACCESS_TTL='15m'
JWT_REFRESH_TTL='30d'
REFRESH_PREFIX='refresh:'

# В проде включать: без капчи регистрация и формы писем открыты для перебора.
TURNSTILE_SECRET_KEY=''
TURNSTILE_ENABLED='false'

# SMTP. Значения ниже — локальный mailpit (docker compose up mailpit, письма
# видно на http://localhost:8025). Для реальной отправки подставьте данные
# провайдера: см. docs/mail-delivery.md. Проверить связку: `npm run mail:test`.
MAIL_HOST='localhost'
MAIL_PORT=1025
MAIL_USER=''
MAIL_PASSWORD=''
# Адрес в From. Домен должен быть тем, для которого у провайдера настроены
# SPF/DKIM/DMARC, иначе письма уйдут в спам или будут отклонены.
MAIL_FROM='BuildVerdict <no-reply@buildverdict.local>'

# Шифрование. Пусто — вывод по порту: 465 = TLS сразу, остальные = STARTTLS,
# если задан MAIL_USER. Переопределяйте, только если провайдер требует иного.
MAIL_SECURE=''
MAIL_REQUIRE_TLS=''
# 'false' отключает проверку сертификата SMTP-сервера. Только для локального
# сервера с самоподписанным сертификатом, в проде оставлять пустым.
MAIL_TLS_REJECT_UNAUTHORIZED=''
