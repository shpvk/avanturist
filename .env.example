NODE_ENV='development'

APPLICATION_PORT=4000
APPLICATION_URL='http://localhost:${APPLICATION_PORT}'
ALLOWED_ORIGIN='http://localhost:3000,http://localhost:3001'

POSTGRES_USER='root'
POSTGRES_PASSWORD='example_password'
POSTGRES_HOST='localhost'
POSTGRES_PORT=5433
POSTGRES_DB='full-authorization'
POSTGRES_URI='postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}'

REDIS_USER='default'
REDIS_PASSWORD='example_password'
REDIS_HOST='localhost'
REDIS_PORT=6379
REDIS_URI='redis://${REDIS_USER}:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}'

SESSION_SECRET='example_session_secret'
SESSION_NAME='buildverdict.sid'
SESSION_DOMAIN='localhost'
SESSION_MAX_AGE='7d'
SESSION_HTTP_ONLY='true'
SESSION_SECURE='false'
SESSION_FOLDER='sessions:'
COOKIES_SECRET='example_cookies_secret'
