    "backend:start": "node apps/backend/dist/main.js",
    "backend:test": "jest",
    "frontend": "npm --prefix apps/frontend run dev",
    "frontend:build": "npm --prefix apps/frontend run build",
    "frontend:start": "npm --prefix apps/frontend run start",
    "frontend:test": "npm --prefix apps/frontend run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:seed": "npm run backend:build && node apps/backend/dist/database/seed.js"
  },
