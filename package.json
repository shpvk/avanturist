{
  "name": "build-verdict",
  "private": true,
  "scripts": {
    "dev": "npm run db:up && npm run db:migrate && concurrently -k -n backend,frontend -c cyan,magenta \"npm:backend\" \"npm:frontend\"",
    "build": "npm run backend:build && npm run frontend:build",
    "start": "concurrently -k -n backend,frontend -c cyan,magenta \"npm:backend:start\" \"npm:frontend:start\"",
    "serve": "npm run db:up && npm run db:migrate && npm run build && npm run start",
    "test": "npm run backend:test && npm run frontend:test",
    "prisma:generate": "prisma generate",
    "prebackend": "prisma generate",
    "backend": "nest start --watch",
    "prebackend:build": "prisma generate",
    "backend:build": "nest build",
    "backend:start": "node apps/backend/dist/main.js",
    "prebackend:test": "prisma generate",
    "backend:test": "jest",
    "frontend": "npm --prefix apps/frontend run dev",
    "frontend:build": "npm --prefix apps/frontend run build",
    "frontend:start": "npm --prefix apps/frontend run start",
    "frontend:test": "npm --prefix apps/frontend run test",
    "dota:sync": "node scripts/sync-dota-constants.mjs",
    "tg:import": "tsx scripts/import-telegram-builds.ts",
    "mail:test": "tsx --tsconfig apps/backend/tsconfig.json scripts/send-test-mail.ts",
    "db:up": "docker compose up -d --wait db redis mailpit",
    "db:migrate": "prisma migrate deploy",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^19.2.18",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "jest": "^30.4.2",
    "prisma": "^7.9.1",
    "ts-jest": "29.4",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shpvk/avanturist.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/shpvk/avanturist/issues"
  },
  "homepage": "https://github.com/shpvk/avanturist#readme",
  "dependencies": {
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-email/components": "^1.0.12",
    "@react-email/html": "^0.0.12",
    "@types/node": "^26.2.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "mysql2": "^3.24.3"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true
  }
